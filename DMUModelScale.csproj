<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.15.0</Version>
    <Author>DMU Model Scale</Author>
    <Name>Sm0ll Chaos &amp; Exdeath</Name>
    <Punchline>Locally shrink Chaos and Exdeath models in Dancing Mad (Ultimate).</Punchline>
    <Description>Scales Chaos and Exdeath in Dancing Mad (Ultimate). Brainrot adds phase model, name and VFX changes, bundled music, and a P3 slam sound.</Description>
    <RepoUrl>https://github.com/Tataru-business/sm0ll-chaos-exdeath</RepoUrl>
    <Tags>utility;visual;dmu</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Media Foundation and Direct3D 11 bindings for the floor video. Dalamud ships this assembly. -->
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="Assets\Audio\*.mp3" />
  </ItemGroup>
</Project>
